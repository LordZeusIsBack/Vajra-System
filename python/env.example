# ── IPFS ──────────────────────────────────────────────────────────────────────
# URL of the running Kubo (go-ipfs) daemon's RPC API
IPFS_API_URL=http://127.0.0.1:5001

# ── Shamir SSS defaults ────────────────────────────────────────────────────────
# Total number of shards to generate per upload
DEFAULT_N=10
# Minimum shards required to reconstruct the file key
DEFAULT_K=8
# Hard upper bound on n (enforced even when overridden per-request)
MAX_SHARDS=50
# Hard lower bound on k
MIN_THRESHOLD=2

# ── Manifest signing ───────────────────────────────────────────────────────────
# HMAC-SHA256 key used to sign manifests. Change this in any real deployment!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MANIFEST_HMAC_SECRET=change-me-before-any-real-use

# ── Upload limits ──────────────────────────────────────────────────────────────
# Max PDF size in bytes (default: 50 MB)
MAX_UPLOAD_BYTES=52428800
