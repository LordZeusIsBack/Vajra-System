# ─────────────────────────────────────────────────────────────────────────────
#  VAJRA Source Vault — example environment file
#
#  Copy this to `.env` (in the same `python/` directory) and fill in values.
#  Never commit `.env` itself — only this template.
#
#    cp env.example .env       # macOS / Linux
#    copy env.example .env     # Windows cmd
# ─────────────────────────────────────────────────────────────────────────────


# ─── Manifest signing (REQUIRED) ─────────────────────────────────────────────
# HMAC-SHA256 key used to sign every manifest before upload to IPFS.
# Centers verify this signature before trusting any CID, so once exams are
# locked with one secret, rotating it invalidates every prior manifest.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Leave this blank in env.example so the app refuses to start with the
# template values. Paste your generated 64-char hex string into .env only.
MANIFEST_HMAC_SECRET=


# ─── Rust binary (REQUIRED for /api/v1/lock) ─────────────────────────────────
# Path to the compiled `vajra` binary produced by `make rs-build`.
# Relative paths are resolved from the `python/` directory.
#
#   Linux / macOS: ../rust/target/release/vajra
#   Windows:       ..\rust\target\release\vajra.exe
VAJRA_BIN=../rust/target/release/vajra

# Max wall-clock seconds for a single vajra subprocess call.
# Must comfortably exceed the 2-second benchmark inside `vajra generate`
# plus any slow `vajra lock` runs. Bump this if you see "Timed out" errors.
VAJRA_TIMEOUT_SECS=300


# ─── IPFS nodes (REQUIRED) ───────────────────────────────────────────────────
# Comma-separated Kubo RPC API URLs. Shards are distributed round-robin
# across all listed nodes; one node going down doesn't block reconstruction
# as long as enough other nodes hold k valid Shamir shares.
#
# Single local node (default Kubo install):
#   IPFS_API_URLS=http://127.0.0.1:5001
#
# Three local Kubo daemons on different ports (recommended for local testing):
#   IPFS_API_URLS=http://127.0.0.1:5001,http://127.0.0.1:5002,http://127.0.0.1:5003
IPFS_API_URLS=http://127.0.0.1:5001,http://127.0.0.1:5002,http://127.0.0.1:5003


# ─── Shamir Secret Sharing defaults ──────────────────────────────────────────
# Per-request overrides on POST /api/v1/lock take precedence over these.
#
# n = total shards produced (one per exam center / IPFS node)
# k = threshold: ANY k of the n shards reconstruct the data key
DEFAULT_N=10
DEFAULT_K=8

# Hard caps enforced regardless of per-request overrides.
# MAX_SHARDS ≤ 255 because Shamir over GF(2^8) only has x-coords in 1..255.
MAX_SHARDS=50
MIN_THRESHOLD=2


# ─── Upload limits ───────────────────────────────────────────────────────────
# Max exam PDF upload size in bytes. Default 50 MB (50 * 1024 * 1024).
MAX_UPLOAD_BYTES=52428800
