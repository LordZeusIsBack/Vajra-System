# ─────────────────────────────────────────────────────────────────────
# VAJRA Source Vault — environment configuration template
#
# Copy this file to `.env` and fill in real values:
#
#     cp env.example .env
#     # then edit .env
#
# IMPORTANT: .env is in .gitignore. Never commit it. The values below
# are placeholders — generate real secrets locally.
# ─────────────────────────────────────────────────────────────────────


# ─── Rust binary path ────────────────────────────────────────────────
# Where the compiled vajra binary lives. After `make rs-build` or
# `cd rust && cargo build --release`, the binary is here:
VAJRA_BIN=../rust/target/release/vajra

# Max wall-clock seconds for any vajra subprocess call. The benchmark
# step inside `vajra generate` takes ~2 seconds; the rest is fast.
# Increase if your machine is unusually slow.
VAJRA_TIMEOUT_SECS=300


# ─── IPFS nodes (Kubo HTTP RPC) ──────────────────────────────────────
# Comma-separated list of Kubo RPC API URLs. Shards are distributed
# round-robin across these nodes for redundancy. Even one local node
# is fine for a demo; production should use multiple geographically
# distributed nodes.
IPFS_API_URLS=http://127.0.0.1:5001


# ─── Centres registry ────────────────────────────────────────────────
# Path to centers.json, the registry mapping centre IDs to X25519
# public keys. Generated by:
#     uv run python vajra_keygen.py bulk --n 10 --out-dir ./keys
CENTERS_REGISTRY_PATH=./keys/centers.json


# ─── Shamir defaults ─────────────────────────────────────────────────
# Default n (total shares) and k (threshold) used when a lock request
# omits them. The /api/v1/lock endpoint accepts n and k overrides per
# request.
DEFAULT_N=10
DEFAULT_K=8

# Hard limits enforced by the validator. n is bounded by the
# GF(2^8) field used for Shamir (255 x-coords available).
MAX_SHARDS=50
MIN_THRESHOLD=2


# ─── Manifest signing ────────────────────────────────────────────────
# HMAC-SHA256 key for manifest signatures. THIS IS A REAL SECRET —
# anyone who has it can forge manifests.
#
# Generate a real one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# The placeholder below will be REJECTED by the config validator.
# You must change it before the server will start.
MANIFEST_HMAC_SECRET=change-me-before-any-real-use


# ─── Upload limits ───────────────────────────────────────────────────
# Maximum size of an uploaded exam PDF, in bytes. Default 50 MB.
MAX_UPLOAD_BYTES=52428800


# ─── drand (Layer A: time anchor) ────────────────────────────────────
# League of Entropy mainnet — constants are public and immutable.
# Override only if you know what you're doing.
DRAND_CHAIN_HASH=8990e7a9aaed2ffed73dbd7092123d6f289930540d7651336225dc172e51b2ce
DRAND_GENESIS=1595431050
DRAND_PERIOD=30

# Comma-separated drand HTTP relay URLs. Defaults are League of Entropy
# public relays.
DRAND_RELAYS=https://api.drand.sh,https://api2.drand.sh,https://api3.drand.sh,https://drand.cloudflare.com

# Minimum number of relays that must return identical (signature, randomness)
# for a round before VAJRA trusts it. With 4 relays, 2 is a sensible default
# (tolerates 2 down or 1 dishonest). Cannot exceed number of configured relays.
DRAND_AGREEMENT_THRESHOLD=2

# Per-request HTTP timeout when fetching drand rounds (seconds).
DRAND_TIMEOUT_SECS=10
